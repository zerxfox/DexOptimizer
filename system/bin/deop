#!/system/bin/sh

LANG=$(settings get system system_locales)
SDK_VERSION=$(getprop ro.build.version.sdk)
DIRMOD="/storage/emulated/0/DexOptimizer"
LOG_FILE="${DIRMOD}/script_log.txt"
CURRENT_VERSION="9.0.0"

OPRESTY_HOST="127.0.0.1"
OPRESTY_PORT="8080"

MODMGR_LIB="/data/adb/modules/dex_optimizer/webroot/modmgr.sh"

LATEST_VERSION=""
VERSION_CHECKED=""

worker_count=()
worker_total=()
parts=()

is_russian() {
  [[ "$LANG" == *"en-RU"* ]] || [[ "$LANG" == *"ru-"* ]]
}

t() { is_russian && echo "$1" || echo "$2"; }

log_msg() { echo "$1" | tee -a "$LOG_FILE"; }

is_number() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

valid_choice() {
  is_number "$1" && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

ask() {
  local _var="$1" _ru="$2" _en="$3" _min="$4" _max="$5" _val
  while true; do
    t "$_ru" "$_en" | tr -d '\n'
    read -r _val
    if valid_choice "$_val" "$_min" "$_max"; then
      eval "$_var=\$_val"
      return 0
    fi
    t "Ошибка: введите число от $_min до $_max" \
      "Error: enter a number from $_min to $_max"
  done
}

ask_profile() {
  local _var="$1" _val
  t "1: everything-profile: выявляет узкие места в коде, улучшает производительность.
2: speed-profile: оптимизирует скорость выполнения, улучшает отклик интерфейса." \
    "1: everything-profile: identifies bottlenecks in the code to improve performance.
2: speed-profile: optimizes execution speed, enhances interface responsiveness."
  while true; do
    t "Выбери профиль (1: everything-profile, 2: speed-profile): " \
      "Select profile (1: everything-profile, 2: speed-profile): " | tr -d '\n'
    read -r _val
    case "$_val" in
      1) eval "$_var=everything-profile"; return ;;
      2) eval "$_var=speed-profile";      return ;;
      *) log_msg "$(t "Ошибка: неверный выбор профиля" "Error: invalid profile selection")" ;;
    esac
  done
}

http_local() {
  printf '%s %s HTTP/1.0\r\nHost: %s\r\nContent-Length: 0\r\nConnection: close\r\n\r\n' \
    "$1" "$2" "$OPRESTY_HOST" \
    | nc -w 300 "$OPRESTY_HOST" "$OPRESTY_PORT" 2>/dev/null \
    | tr -d '\r' | sed '1,/^$/d'
}

fetch_latest_version() {
  if [ -z "$VERSION_CHECKED" ]; then
    VERSION_CHECKED=1
    LATEST_VERSION=$(http_local GET /dex_optimizer/check-update \
      | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')
  fi
}

format_elapsed() {
  local diff=$(( $(date +%s) - $1 ))
  echo "$((diff / 60))m $((diff % 60))s"
}

notify_completion() {
  local diff=$(( $(date +%s) - $1 ))
  local msg
  msg="$(t "Время работы скрипта: $((diff / 60)) минут и $((diff % 60)) секунд" \
           "Script execution time: $((diff / 60)) minutes and $((diff % 60)) seconds.")"
  su -lp 2000 -c "cmd notification post -S bigtext -t 'DexOptimizer' 'Tag' '$msg' >/dev/null 2>&1"
  log_msg "$msg"
}

choose_profile() {
  local pkg="$1" bucket
  bucket=$(am get-standby-bucket "$pkg" 2>/dev/null | head -n 1 | tr -d '[:space:]')
  if is_number "$bucket" && [ "$bucket" -gt 10 ]; then
    echo "speed-profile"
  else
    echo "everything-profile"
  fi
}

elapsed_to_seconds() {
  local raw="${1%ms}" total=0 num
  while [ -n "$raw" ]; do
    num=${raw%%[!0-9]*}
    [ -n "$num" ] || break
    raw=${raw#"$num"}
    num=${num#"${num%%[!0]*}"}; num=${num:-0}
    case "$raw" in
      d*) total=$((total + num * 86400)); raw=${raw#d} ;;
      h*) total=$((total + num * 3600));  raw=${raw#h} ;;
      m*) total=$((total + num * 60));    raw=${raw#m} ;;
      s*) total=$((total + num));         raw=${raw#s} ;;
      *)  break ;;
    esac
  done
  echo "$total"
}

choose_profile_old() {
  local pkg="$1" raw total
  raw=$(dumpsys usagestats 2>/dev/null \
        | grep -F "package=$pkg " \
        | grep -o 'lastUsedElapsed=+[0-9a-z]*' \
        | head -n 1 \
        | sed 's/^lastUsedElapsed=+//')
  [ -z "$raw" ] && { echo "everything-profile"; return; }
  total=$(elapsed_to_seconds "$raw")
  [ "$total" -gt 600 ] && echo "speed-profile" || echo "everything-profile"
}

auto_profile() {
  if [ "$SDK_VERSION" -ge 23 ] && [ "$SDK_VERSION" -le 27 ]; then
    choose_profile_old "$1"
  else
    choose_profile "$1"
  fi
}

get_package_size() {
  local pkg="$1" path size
  path=$(pm path "$pkg" | cut -d':' -f2)
  [ -z "$path" ] && echo 0 && return
  size=$(stat -c%s "$path" 2>/dev/null)
  echo "${size:-0}"
}

list_packages() {
  pm list packages ${1:+"$1"} | cut -d':' -f2
}

sort_by_size() {
  while read -r pkg; do
    echo "$(get_package_size "$pkg") $pkg"
  done | sort -nr
}

_run_timed() {
  local t0
  t0=$(date +%s)
  CMD_OUTPUT=$("$@" 2>&1)
  TIME_RESULT=$(format_elapsed "$t0")
}

_log_result() {
  local idx="$1" total="$2" app="$3" status="$4" time="$5" extra="$6"
  log_msg "$(t \
"┌─ Прогресс: $idx | $total
├─ Приложение: $app
$extra
├─ Статус: $status
├─ Время: $time
└─ Воркер: #$(( $7 + 1 ))" \
"┌─ Progress: $idx | $total
├─ App: $app
$extra
├─ Status: $status
├─ Time: $time
└─ Worker: #$(( $7 + 1 ))")"
}

reset_app() {
  local widx="$1" app="$2" status
  _run_timed cmd package compile --reset "$app"
  echo "$CMD_OUTPUT" | grep -q "Success" \
    && status=$(t "Успех" "Success") \
    || status=$(t "Ошибка" "Failed")
  worker_count[$widx]=$(( worker_count[$widx] + 1 ))
  _log_result "${worker_count[$widx]}" "${worker_total[$widx]}" \
    "$app" "$status" "$TIME_RESULT" "" "$widx"
}

run_compile() {
  local profile="$1" app="$2"
  if ! is_number "$SDK_VERSION" || [ "$SDK_VERSION" -lt 23 ]; then
    echo "Unsupported SDK: $SDK_VERSION"
    return 1
  elif [ "$SDK_VERSION" -ge 34 ]; then
    cmd package compile -m "$profile" -p PRIORITY_INTERACTIVE_FAST -f --full "$app" 2>&1
  elif [ "$SDK_VERSION" -ge 29 ]; then
    cmd package compile -m "$profile" -f "$app" 2>&1
  else
    cmd package compile -m "$profile" --check-prof true -f "$app" 2>&1
  fi
}

compile_app() {
  local widx="$1" app="$2" profile="$3" status
  _run_timed run_compile "$profile" "$app"
  echo "$CMD_OUTPUT" | grep -q "Success" \
    && status=$(t "Успех" "Success") \
    || status=$(t "Ошибка" "Failed")
  worker_count[$widx]=$(( worker_count[$widx] + 1 ))
  _log_result "${worker_count[$widx]}" "${worker_total[$widx]}" \
    "$app" "$status" "$TIME_RESULT" \
    "$(t "├─ Профиль: $profile\n" "├─ Profile: $profile\n")" "$widx"
}

run_worker_compile() {
  local widx="$1" profile_mode="$2" pack
  for pack in ${parts[$widx]}; do
    if [ "$profile_mode" = "auto" ]; then
      compile_app "$widx" "$pack" "$(auto_profile "$pack")"
    else
      compile_app "$widx" "$pack" "$profile_mode"
    fi
  done
}

run_worker_reset() {
  local widx="$1" pack
  for pack in ${parts[$widx]}; do
    reset_app "$widx" "$pack"
  done
}

partition_into() {
  local n="$1" sorted="$2" i=0 idx size pkg

  while [ $i -lt "$n" ]; do
    parts[$i]=""
    worker_count[$i]=0
    worker_total[$i]=0
    i=$(( i + 1 ))
  done

  i=0
  while read -r size pkg; do
    idx=$(( i % n ))
    parts[$idx]="${parts[$idx]} $pkg"
    worker_total[$idx]=$(( worker_total[$idx] + 1 ))
    i=$(( i + 1 ))
  done <<< "$sorted"
}

dispatch_parallel() {
  local mode="$1" n="$2" profile="${3:-}" i=0
  while [ $i -lt "$n" ]; do
    if [ "$mode" = "compile" ]; then
      run_worker_compile "$i" "$profile" &
    else
      run_worker_reset "$i" &
    fi
    i=$(( i + 1 ))
  done
  wait
}

reset_mode() {
  local PARTS sorted
  ask PARTS \
    "Выбери максимальное число процессов (10 - максимум): " \
    "Select the maximum count of PROCESSES (10 - max): " 1 10

  log_msg "$(t "¦ Сортировка приложений по размеру" "¦ Sorting applications by size")"
  sorted=$(list_packages | sort_by_size)
  partition_into "$PARTS" "$sorted"

  log_msg "$(t "¦ Очистка профиля приложений" "¦ Clearing apps profile")"
  dispatch_parallel reset "$PARTS"
  log_msg "$(t "¦ Профиль приложений очищен" "¦ Apps profile cleared")"
}

script_mode() {
  local PARTS WORK PACKAGES profile packages_file bgdj sorted total start

  ask WORK \
    "Выбери режим скрипта (1: Автоматический, 2: Ручной): " \
    "Select the script mode (1: Automatic, 2: Manual): " 1 2

  if [ "$WORK" -eq 2 ]; then
    ask PACKAGES \
      "Выбери приложения (1: Пользовательские, 2: Системные, 3: Все): " \
      "Select apps (1: User, 2: System, 3: All): " 1 3
    ask_profile profile
  else
    PACKAGES=3
    profile="auto"
  fi

  case "$PACKAGES" in
    1) packages_file=$(list_packages -3) ;;
    2) packages_file=$(list_packages -s) ;;
    3) packages_file=$(list_packages)    ;;
  esac

  if [ "${1:-0}" -eq 999 ] 2>/dev/null; then
    PARTS=25
  else
    ask PARTS \
      "Выбери максимальное число процессов (10 - максимум): " \
      "Select the maximum count of PROCESSES (10 - max): " 1 10
  fi

  ask bgdj \
    "Запустить задачу оптимизации DEX? (1: Да, 2: Нет): " \
    "Execute DEX optimization task? (1: Yes, 2: No): " 1 2

  log_msg "$(t "¦ Сортировка приложений по размеру" "¦ Sorting applications by size")"
  sorted=$(echo "$packages_file" | sort_by_size)
  total=$(echo "$sorted" | wc -l)
  partition_into "$PARTS" "$sorted"

  echo ""
  if [ "$WORK" -eq 1 ]; then
    log_msg "$(t "¦ Режим: Автоматический" "¦ Mode: Automatic")"
  else
    log_msg "$(t "¦ Режим: Ручной"                "¦ Mode: Manual")"
    log_msg "$(t "¦ Пакеты: $PACKAGES"            "¦ Packages: $PACKAGES")"
    log_msg "$(t "¦ Профиль: $profile"             "¦ Profile: $profile")"
  fi
  log_msg "$(t "¦ Воркеров: $PARTS"       "¦ Workers: $PARTS")"
  log_msg "$(t "¦ Приложений: $total"     "¦ Apps: $total")"
  echo ""
  log_msg "$(t "¦ Компиляция запущена" "¦ Compilation started")"
  start=$(date +%s)

  dispatch_parallel compile "$PARTS" "$profile"

  if [ "$bgdj" -eq 1 ]; then
    log_msg "$(t "¦ Задача bg-dexopt-job" "¦ Running bg-dexopt-job")"
    local out
    out=$(cmd package bg-dexopt-job 2>&1)
    if echo "$out" | grep -q "Job finished"; then
      log_msg "$(t "¦ Задача завершена" "¦ Task finished")"
    else
      log_msg "$(t "¦ Ошибка задачи" "¦ Task error")"
    fi
  fi

  notify_completion "$start"
}

select_app_by_name() {
  local packages_file matched apps_count app choice num selected profile

  packages_file=$(list_packages)

  while true; do
    t "Введите имя или часть имени приложения: " \
      "Enter the name or part of the app name: " | tr -d '\n'
    read -r app_name

    matched=$(echo "$packages_file" | grep -i "$app_name")
    [ -n "$matched" ] && break

    t "Приложение '$app_name' не найдено. Попробовать снова (1) или выйти (2)?: " \
      "App '$app_name' not found. Try again (1) or go back (2)?: " | tr -d '\n'
    read -r choice
    case "$choice" in
      2) return ;;
    esac
  done

  t "¦ Найдены приложения:" "¦ Found applications:"
  apps_count=0
  for app in $matched; do
    apps_count=$(( apps_count + 1 ))
    echo "$apps_count: $app"
  done
  echo ""

  selected=""
  if [ "$apps_count" -eq 1 ]; then
    selected="$matched"
  else
    while true; do
      t "Выбери (1: все, 2: конкретное): " "Select (1: all, 2: specific): " | tr -d '\n'
      read -r choice
      case "$choice" in
        1) selected="$matched"; break ;;
        2)
          t "Номер приложения: " "App number: " | tr -d '\n'
          read -r num
          app=$(echo "$matched" | sed -n "${num}p")
          if [ -n "$app" ]; then selected="$app"; break
          else t "Некорректный номер" "Invalid number"; fi ;;
        *) t "Введите 1 или 2" "Enter 1 or 2" ;;
      esac
    done
  fi

  ask_profile profile
  echo ""
  for app in $selected; do
    compile_app 0 "$app" "$profile"
  done
}

show_changelog() {
  local content
  content=$(http_local GET /dex_optimizer/changelog)
  if [ -n "$content" ]; then
    clear
    echo "╔════════════════════════════════════════════╗"
    echo "║───────────DexOptimizer Changelog───────────║"
    echo "╚════════════════════════════════════════════╝"
    echo "$content"
  else
    t "Не удалось загрузить changelog (нет интернета или локальный сервер недоступен)" \
      "Failed to load changelog (no internet or local server unavailable)"
  fi
}

module_update() {
  local zip_file="/data/local/tmp/dex_optimizer.zip" resp reboot_choice

  log_msg "$(t "Проверка обновлений" "Checking for updates")"
  VERSION_CHECKED=""; LATEST_VERSION=""
  fetch_latest_version

  if [ -z "$LATEST_VERSION" ]; then
    log_msg "$(t "Нет интернета или локальный сервер недоступен" "No internet or local server unavailable")"
    return
  fi
  if [ "$LATEST_VERSION" = "$CURRENT_VERSION" ]; then
    log_msg "$(t "Обновлений нет" "No updates available")"
    return
  fi

  if [ ! -r "$MODMGR_LIB" ]; then
    log_msg "$(t "Не найден $MODMGR_LIB" "Not found: $MODMGR_LIB")"
    return 1
  fi
  . "$MODMGR_LIB"
  if ! find_module_managers; then
    log_msg "$(t "Не удалось определить менеджер модулей. Проверено:" "Failed to determine the module manager. Checked:")"
    log_msg "$(modmgr_searched)"
    return 1
  fi

  log_msg "$(t "Загрузка версии $LATEST_VERSION" "Downloading version $LATEST_VERSION")"
  resp=$(http_local POST /dex_optimizer/download-update)
  case "$resp" in
    OK*) ;;
    *)
      log_msg "$(t "Не удалось загрузить файл: $resp" "Failed to download file: $resp")"
      return
      ;;
  esac

  if [ ! -s "$zip_file" ]; then
    log_msg "$(t "Загруженный файл повреждён или пуст" "Downloaded file is corrupted or empty")"
    return
  fi

  log_msg "$(t "Установка" "Installing")"
  if ! install_module_zip "$zip_file"; then
    return 1
  fi

  log_msg "$(t "Обновлено до $LATEST_VERSION" "Updated to $LATEST_VERSION")"
  ask reboot_choice \
    "Перезагрузить устройство? (1: Да, 2: Нет): " \
    "Reboot the device? (1: Yes, 2: No): " 1 2
  [ "$reboot_choice" -eq 1 ] && reboot
}

show_menu() {
  echo "╔════════════════════════════════════════════╗"
  echo "║─────────────DexOptimizer Menu──────────────║"
  echo "╚════════════════════════════════════════════╝"
  echo ""

  fetch_latest_version
  if [ -z "$LATEST_VERSION" ]; then
    t "Нет интернета или локальный сервер недоступен" "No internet or local server unavailable"
  elif [ "$LATEST_VERSION" != "$CURRENT_VERSION" ]; then
    t "Доступна новая версия: $LATEST_VERSION" "New version available: $LATEST_VERSION"
  else
    t "Актуальная версия: $CURRENT_VERSION" "Up to date: $CURRENT_VERSION"
  fi

  echo ""
  t "[1] Начать компиляцию приложений"      "[1] Start compiling apps"
  t "[2] Выбрать профиль приложению"        "[2] Compile a specific app"
  t "[3] Очистить профиль всех приложений"  "[3] Reset all app profiles"
  t "[4] Обновить модуль"                   "[4] Update module"
  t "[5] Показать изменения"                "[5] Show changelog"
  t "[6] Выход"                             "[6] Exit"
  echo ""
  t "Выберите опцию: " "Select an option: " | tr -d '\n'
}

main_loop() {
  local sel="$1"
  while true; do
    case "$sel" in
      1)   script_mode "$sel" ;;
      2)   select_app_by_name ;;
      3)   reset_mode ;;
      4)   module_update ;;
      5)   show_changelog ;;
      6)   exit 0 ;;
      999) script_mode "$sel" ;;
      *)   t "Ошибка: введите от 1 до 6" "Error: enter 1 to 6" ;;
    esac
    show_menu
    read -r sel
  done
}

mkdir -p "$DIRMOD"
: > "$LOG_FILE"
log_msg "$(t \
  "Устройство: $(getprop ro.product.name) | $(getprop ro.product.system.model) | v$CURRENT_VERSION" \
  "Device: $(getprop ro.product.name) | $(getprop ro.product.system.model) | v$CURRENT_VERSION")"
clear
show_menu
read -r selection
main_loop "$selection"
